---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

// Le bouton « Télécharger mon CV » n'apparaît que si le fichier existe :
// il suffit de déposer le PDF dans public/ sous ce nom.
const CV_PATH = '/cv-melanie-roy.pdf';
const hasCv = existsSync(join(process.cwd(), 'public', CV_PATH));
---
<a class="skip-link" href="#main" data-i18n="nav.skip">Aller au contenu</a>

<header class="nav">
  <div class="container nav__bar">
    <a href="#accueil" class="nav__logo" aria-label="Accueil — Mélanie Roy">
      <img
        class="nav__logo-img nav__logo-img--lockup"
        src="/images/logo-lockup.png"
        alt="Mélanie ROY — Testeuse Logiciel & Développeuse"
        width="605"
        height="163"
      />
      <img
        class="nav__logo-img nav__logo-img--mark"
        src="/images/logo-mark.png"
        alt="Logo MR de Mélanie Roy"
        width="400"
        height="185"
      />
    </a>

    <nav class="nav__links" id="nav-menu" aria-label="Navigation principale">
      <a href="#accueil"     class="nav__link" data-i18n="nav.home">Accueil</a>
      <a href="#a-propos"    class="nav__link" data-i18n="nav.about">À propos</a>
      <a href="#competences" class="nav__link" data-i18n="nav.competences">Compétences</a>
      <a href="#projets"     class="nav__link" data-i18n="nav.projects">Projets</a>
      <a href="#parcours"    class="nav__link" data-i18n="nav.parcours">Parcours</a>
      <a href="#contact"     class="nav__link" data-i18n="nav.contact">Contact</a>
    </nav>

    <div class="nav__actions">
      {hasCv && (
        <a class="btn btn--ghost btn--sm nav__cv" href={CV_PATH} download>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" x2="12" y1="15" y2="3" /></svg>
          <span class="nav__cv-label" data-i18n="nav.cv">Télécharger mon CV</span>
        </a>
      )}
      <button id="lang-toggle" class="nav__lang-btn" type="button" aria-label="Switch to English">EN</button>
      <button
        class="nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Menu de navigation"
      >
        <svg class="icon icon-menu" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><line x1="4" x2="20" y1="12" y2="12" /><line x1="4" x2="20" y1="6" y2="6" /><line x1="4" x2="20" y1="18" y2="18" /></svg>
        <svg class="icon icon-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
      </button>
    </div>
  </div>
</header>

<script>
  import '../scripts/nav';
</script>
