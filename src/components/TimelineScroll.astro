---
import { timeline } from '../data/timeline';
import TimelineItem from './TimelineItem.astro';

const firstYear = timeline[0]?.start ?? '';
---
<section class="timeline" id="parcours" aria-labelledby="timeline-title">
  <div class="timeline__intro">
    <h2 id="timeline-title" data-i18n="timeline.title">Parcours</h2>
    <p class="timeline__subtitle" data-i18n="timeline.subtitle">Du médico-social au développement, une reconversion en quatre actes.</p>
  </div>

  <div class="timeline__stage" aria-label="Animation de la timeline — liste statique ci-dessous">

    <div class="timeline__year-bg" aria-hidden="true">{firstYear}</div>

    <svg
      class="timeline__svg"
      aria-hidden="true"
      focusable="false"
      preserveAspectRatio="none"
    >
      <path class="timeline__svg-track" d="M 2 0 L 2 100" />
      <path class="timeline__svg-progress" d="M 2 0 L 2 100" />
    </svg>

    <div class="timeline__cursor" aria-hidden="true"></div>
    <div class="timeline__phase-label" aria-hidden="true"></div>

    <div class="timeline__inner" role="list">
      {timeline.map((entry, i) => (
        <TimelineItem entry={entry} index={i} />
      ))}
    </div>
  </div>

  <noscript>
    <div class="timeline__static" role="list">
      {timeline.map((entry, i) => (
        <TimelineItem entry={entry} index={i} />
      ))}
    </div>
  </noscript>
</section>

<script>
  import { initTimeline } from '../scripts/timeline';
  initTimeline();
</script>
