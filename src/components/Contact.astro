---
import { profile } from '../data/profile';
import '../styles/contact.css';
---
<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__text reveal">
      <p class="section-eyebrow"><span data-i18n="contact.num">05</span> / <span data-i18n="contact.eyebrow">Contact</span></p>
      <h2 id="contact-title" class="section-title" data-i18n="contact.title">Un poste de développeuse ou de testeuse à pourvoir ? Parlons-en.</h2>
      <p class="contact__intro" data-i18n-html="contact.intro">
        Disponible à <strong>{profile.location}</strong>, ouverte aux opportunités en développement junior comme en tests / QA.
      </p>
      <div class="contact__actions">
        <a id="contact-email" href={profile.linkedin} class="btn btn--primary" data-u={profile.emailUser} data-d={profile.emailDomain} rel="noopener noreferrer" target="_blank" aria-label="Envoyer un email à Mélanie Roy">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
          Email
        </a>
        <a href={profile.linkedin} class="btn btn--ghost-light" rel="noopener noreferrer" target="_blank" aria-label="Voir le profil LinkedIn de Mélanie Roy">LinkedIn</a>
        <a href={profile.github} class="btn btn--ghost-light" rel="noopener noreferrer" target="_blank" aria-label="Voir le profil GitHub de Mélanie Roy">GitHub</a>
      </div>
    </div>

    <form class="contact__form reveal" id="contact-form" novalidate>
      <div class="field">
        <label for="cf-name" data-i18n="contact.form.name">Nom</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-err" />
        <p class="field__err" id="cf-name-err" role="alert"></p>
      </div>
      <div class="field">
        <label for="cf-email" data-i18n="contact.form.email">Email</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required aria-describedby="cf-email-err" />
        <p class="field__err" id="cf-email-err" role="alert"></p>
      </div>
      <div class="field">
        <label for="cf-msg" data-i18n="contact.form.message">Message</label>
        <textarea id="cf-msg" name="message" rows="5" required aria-describedby="cf-msg-err"></textarea>
        <p class="field__err" id="cf-msg-err" role="alert"></p>
      </div>
      <button type="submit" class="btn btn--primary contact__submit"><span data-i18n="contact.form.send">Envoyer</span></button>
      <p class="contact__status" id="cf-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script type="module" src="/scripts/contact.js"></script>
<script>
  import '../scripts/contact-form';
</script>
