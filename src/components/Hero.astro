---
import { profile } from '../data/profile';
import '../styles/hero.css';

const [firstName, ...rest] = profile.name.split(' ');
const lastName = rest.join(' ').toUpperCase();
---
<section class="hero" id="accueil" aria-labelledby="hero-title">
  <svg class="hero__dots" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="hero-dots" width="22" height="22" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1.5" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-dots)" />
  </svg>

  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__location hero-rise hero-rise--1" data-i18n="hero.location">Nantes et alentours</p>
      <p class="hero__hello hero-rise hero-rise--1" data-i18n="hero.hello">Bonjour, je suis</p>
      <h1 id="hero-title" class="hero__name hero-rise hero-rise--2">{firstName} <span>{lastName}</span></h1>
      <p class="hero__role hero-rise hero-rise--3" data-i18n="hero.role">Testeuse Logiciel &amp; Développeuse</p>
      <p class="hero__signature hero-rise hero-rise--3">
        <span data-i18n="hero.sig1">Tester</span><span aria-hidden="true">·</span><span data-i18n="hero.sig2">Développer</span><span aria-hidden="true">·</span><span data-i18n="hero.sig3">Innover</span>
      </p>
      <p class="hero__lead hero-rise hero-rise--4" data-i18n-html="hero.lead">J'ai pris soin des gens pendant 13&nbsp;ans. Aujourd'hui, je prends soin du <em>code</em>.</p>
      <p class="hero__pitch hero-rise hero-rise--4" data-i18n="hero.pitch">{profile.pitch}</p>
      <div class="hero__actions hero-rise hero-rise--4">
        <a href="#projets" class="btn btn--primary">
          <span data-i18n="hero.cta.projects">Voir mes projets</span>
          <svg class="icon icon-go" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
        <a href="#contact" class="btn btn--ghost" data-i18n="hero.cta.contact">Me contacter</a>
      </div>
    </div>

    <div class="hero__visual">
      <svg class="hero__blob" viewBox="0 0 500 580" aria-hidden="true" focusable="false">
        <path class="hero__blob-fill" d="M130 70 C230 -8 410 20 460 150 C510 270 450 440 335 500 C220 560 80 520 40 395 C0 270 28 130 130 70 Z" />
        <path class="hero__blob-line" d="M150 90 C240 28 392 46 440 160 C488 270 434 420 330 476 C226 530 100 494 64 384 C28 274 54 148 150 90 Z" />
      </svg>

      <div class="hero__frame">
        <div class="hero__frame-offset" aria-hidden="true"></div>
        <div class="hero__photo">
          <img
            src="/images/hero-desk.jpg"
            alt="Ordinateur portable affichant du code HTML et CSS sur un bureau lumineux"
            width="1600"
            height="1065"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <svg class="hero__swoosh" viewBox="0 0 400 500" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="hero-swoosh" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" stop-color="#087F6B" />
              <stop offset="0.55" stop-color="#12A99A" />
              <stop offset="1" stop-color="#12A99A" stop-opacity="0" />
            </linearGradient>
          </defs>
          <ellipse cx="200" cy="250" rx="228" ry="104" transform="rotate(-26 200 250)" />
        </svg>
        <svg class="hero__pixels" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
          <rect x="20" y="22" width="14" height="14" fill="#087F6B" />
          <rect x="40" y="8" width="9" height="9" fill="#12A99A" />
          <rect x="6" y="40" width="10" height="10" fill="#B8E8DD" />
          <rect x="42" y="32" width="7" height="7" fill="#B8E8DD" />
        </svg>

        <p class="hero__chip hero__chip--a" aria-hidden="true"><span>&#123;</span> tester <span>&#125;</span></p>
        <p class="hero__chip hero__chip--b" aria-hidden="true">&lt;/&gt; développer</p>
        <p class="hero__chip hero__chip--c" aria-hidden="true">innover<span>()</span><b>_</b></p>
      </div>
    </div>
  </div>
</section>
